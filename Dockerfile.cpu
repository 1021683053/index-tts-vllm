# The domestic CPU PyTorch mirror currently supplies compatible Linux wheels
# through CPython 3.11. The native CPU backend does not require vLLM's 3.12.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i \
            -e 's|deb.debian.org|mirrors.aliyun.com|g' \
            -e 's|security.debian.org|mirrors.aliyun.com/debian-security|g' \
            /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ffmpeg \
        libsndfile1 \
        libsm6 \
        libxext6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-cpu.txt ./
RUN pip install --no-cache-dir uv \
    && pip install --no-cache-dir \
        https://mirrors.aliyun.com/pytorch-wheels/cpu/torch-2.1.2%2Bcpu-cp311-cp311-linux_x86_64.whl \
        https://mirrors.aliyun.com/pytorch-wheels/cpu/torchaudio-2.1.2%2Bcpu-cp311-cp311-linux_x86_64.whl \
    && uv pip install --system \
        --default-index https://mirrors.aliyun.com/pypi/simple \
        -r requirements-cpu.txt

COPY indextts /app/indextts
COPY tools /app/tools
COPY api_server_v2.py /app/api_server_v2.py
COPY webui_v2.py /app/webui_v2.py

# Model weights are mounted at runtime rather than baked into the image.
EXPOSE 9009
ENTRYPOINT ["python", "api_server_v2.py", "--backend", "torch", "--device", "cpu"]
